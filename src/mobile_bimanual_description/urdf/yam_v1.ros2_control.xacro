<?xml version="1.0"?>


<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro"
    name="yam_v1">

    <xacro:arg
        name="mujoco_model"
        default="$(find mobile_bimanual_description)/mujoco/yam_v1/yam_empty.xml" />

    <xacro:arg
        name="headless"
        default="false" />

    <!-- ============================================================= -->
    <!-- YAM kinematic chain                                           -->
    <!-- ============================================================= -->

    <link name="base" />
    <link name="link1" />
    <link name="link2" />
    <link name="link3" />
    <link name="link4" />
    <link name="link5" />
    <link name="gripper" />

    <joint name="joint1" type="revolute">
        <origin
            xyz="-2.49777947129965e-07 -9.17402363407408e-13 0.0679999999995413"
            rpy="0 1.5708 3.1415963267949" />
        <axis xyz="-1 0 0" />
        <parent link="base" />
        <child link="link1" />
        <limit
            effort="1"
            velocity="1"
            lower="-2.61799"
            upper="3.14159" />
    </joint>

    <joint name="joint2" type="revolute">
        <origin
            xyz="-0.0455 -0.0339 -0.02"
            rpy="-1.7953e-16 5.55112e-17 -3.14159" />
        <axis xyz="3.58252e-15 1 -3.2007e-16" />
        <parent link="link1" />
        <child link="link2" />
        <limit
            effort="1"
            velocity="1"
            lower="-8.88178e-16"
            upper="3.66519" />
    </joint>

    <joint name="joint3" type="revolute">
        <origin
            xyz="4.08431e-07 -0.0688 0.264"
            rpy="-2.99502e-14 -1.6015e-14 -3.14159" />
        <axis xyz="4.54273e-15 1 1.04275e-14" />
        <parent link="link2" />
        <child link="link3" />
        <limit
            effort="1"
            velocity="1"
            lower="0"
            upper="3.14159" />
    </joint>

    <joint name="joint4" type="revolute">
        <origin
            xyz="-0.0600003 -0.0688 -0.244999"
            rpy="2.95536e-14 8.52374e-14 -2.10585e-14" />
        <axis xyz="0 1 0" />
        <parent link="link3" />
        <child link="link4" />
        <limit
            effort="1"
            velocity="1"
            lower="-1.69297"
            upper="1.5708" />
    </joint>

    <joint name="joint5" type="revolute">
        <origin
            xyz="-0.0405003 0.0338995 -0.0739989"
            rpy="2.73264e-14 -4.32956e-16 -8.32667e-17" />
        <axis xyz="1 0 0" />
        <parent link="link4" />
        <child link="link5" />
        <limit
            effort="1"
            velocity="1"
            lower="-1.5708"
            upper="1.5708" />
    </joint>

    <joint name="joint6" type="revolute">
        <origin
            xyz="0.0404996 2.39858e-07 -0.0356"
            rpy="8.83309e-16 -5.88588e-16 7.69861e-14" />
        <axis xyz="1.46014e-15 2.40808e-14 -1" />
        <parent link="link5" />
        <child link="gripper" />
        <limit
            effort="1"
            velocity="1"
            lower="-2.0944"
            upper="2.0944" />
    </joint>

    <!-- ============================================================= -->
    <!-- ros2_control                                                  -->
    <!-- ============================================================= -->

    <ros2_control name="YamMujocoSystem" type="system">

        <hardware>
            <plugin>
                mujoco_ros2_control/MujocoSystemInterface
            </plugin>

            <param name="mujoco_model">
                $(arg mujoco_model)
            </param>

            <param name="headless">
                $(arg headless)
            </param>
        </hardware>

        <joint name="joint1">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="joint2">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="joint3">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="joint4">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="joint5">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="joint6">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
    </ros2_control>

</robot>
