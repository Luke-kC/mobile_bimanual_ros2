<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="pedestal" params="collapsed_height_m">

        <!-- Pedestal links -->
        <link name="pedestal_base_link">
            <visual>
                <origin xyz="0 0 ${float(collapsed_height_m) / 2.0}" rpy="0 0 0"/>
                <geometry>
                    <box size="0.12 0.12 ${collapsed_height_m}"/>
                </geometry>
            </visual>
         </link>

        <joint name="pedestal_joint" type="prismatic">
            <parent link="pedestal_base_link"/>
            <child link="pedestal_top_link"/>
            <origin xyz="0 0 ${collapsed_height_m}" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <!-- effort and velocity limits are placeholders -->
            <limit lower="0.0" upper="0.418" effort="100" velocity="2.0"/>
        </joint>

        <link name="pedestal_top_link">
            <visual>
                <origin xyz="0 0 -0.01" rpy="0 0 0"/>
                <geometry>
                    <box size="0.14 0.14 0.02"/>
                </geometry>
            </visual>
        </link>

    </xacro:macro>

</robot>
