{
    "name": "Mobile Bimanual ROS 2 (Linux)",

    "build": {
        "dockerfile": "../Dockerfile",
        "context": "../.."
    },

    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",

    "remoteUser": "ubuntu",
    "updateRemoteUserUID": true,

    "runArgs": [
        "--init",
        "--network=host"
    ],

    "containerEnv": {
        "RCUTILS_COLORIZED_OUTPUT": "1"
    },

    "mounts": [
        "source=mobile-bimanual-build,target=/workspace/build,type=volume",
        "source=mobile-bimanual-install,target=/workspace/install,type=volume",
        "source=mobile-bimanual-log,target=/workspace/log,type=volume",
        "source=mobile-bimanual-nvim-data,target=/home/ubuntu/.local/share/nvim,type=volume",
        "source=mobile-bimanual-nvim-state,target=/home/ubuntu/.local/state/nvim,type=volume",
        "source=mobile-bimanual-nvim-cache,target=/home/ubuntu/.cache/nvim,type=volume",
        "source=mobile-bimanual-zsh-state,target=/home/ubuntu/.local/state/zsh,type=volume",
        "source=mobile-bimanual-zsh-cache,target=/home/ubuntu/.cache/zsh,type=volume"
    ],

    "postCreateCommand": "bash .devcontainer/post-create.sh",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-python.python",
                "charliermarsh.ruff",
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools"
            ]
        }
    }
}
