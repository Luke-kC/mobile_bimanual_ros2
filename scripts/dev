#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEFAULT_CONFIG="$ROOT/.devcontainer/devcontainer.json"
LINUX_CONFIG="$ROOT/.devcontainer/linux/devcontainer.json"
LINUX_NVIDIA_CONFIG="$ROOT/.devcontainer/linux-nvidia/devcontainer.json"
GENERATED_CONFIG_DIR="$ROOT/.devcontainer/.generated"
PEDESTAL_DEVICE="/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0"
HOST_ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
CONTAINER_ZDOTDIR="/home/ubuntu/.config/zsh"
CONTAINER_TERM="${DEVCONTAINER_TERM:-xterm-256color}"

usage() {
    cat <<'EOF'
Usage: ./scripts/dev <command>

Commands:
  up       Create or update the development container
  shell    Open zsh in the development container
  nvim     Open the workspace in Neovim in the development container
  rebuild  Recreate the development container after image changes
  stop     Stop devcontainers for this workspace

If ~/.config/nvim exists, it is bind-mounted into containers created by this
script. If $ZDOTDIR (or ~/.config/zsh) exists, it is mounted and used by
interactive shells. Editor data and shell history remain in Docker volumes.

Environment:
  DEVCONTAINER_NVIDIA=auto|1|0      Select NVIDIA devcontainer support.
  DEVCONTAINER_PEDESTAL=auto|1|0    Select pedestal ESP32 passthrough.
EOF
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Missing required command: $1" >&2
        exit 1
    fi
}

config_file() {
    local config
    local pedestal

    if [[ "$(uname -s)" == "Linux" ]]; then
        pedestal="$(pedestal_enabled)"

        case "${DEVCONTAINER_NVIDIA:-auto}" in
            1|true|yes|on)
                config="$LINUX_NVIDIA_CONFIG"
                ;;
            0|false|no|off)
                config="$LINUX_CONFIG"
                ;;
            auto)
                if nvidia_cdi_available; then
                    config="$LINUX_NVIDIA_CONFIG"
                else
                    config="$LINUX_CONFIG"
                fi
                ;;
            *)
                printf 'Invalid DEVCONTAINER_NVIDIA value: %s\n' "$DEVCONTAINER_NVIDIA" >&2
                exit 2
                ;;
        esac

        if [[ "$pedestal" == "1" ]]; then
            generated_config_file "$config"
        else
            printf '%s\n' "$config"
        fi
    else
        printf '%s\n' "$DEFAULT_CONFIG"
    fi
}

pedestal_enabled() {
    case "${DEVCONTAINER_PEDESTAL:-auto}" in
        1|true|yes|on)
            if [[ ! -e "$PEDESTAL_DEVICE" ]]; then
                printf 'Pedestal ESP32 device not found: %s\n' "$PEDESTAL_DEVICE" >&2
                exit 2
            fi
            printf '1\n'
            ;;
        0|false|no|off)
            printf '0\n'
            ;;
        auto)
            if [[ -e "$PEDESTAL_DEVICE" ]]; then
                printf '1\n'
            else
                printf '0\n'
            fi
            ;;
        *)
            printf 'Invalid DEVCONTAINER_PEDESTAL value: %s\n' "$DEVCONTAINER_PEDESTAL" >&2
            exit 2
            ;;
    esac
}

generated_config_file() {
    local config="$1"
    local output_dir="$GENERATED_CONFIG_DIR/$(basename "$(dirname "$config")")-pedestal"
    local output="$output_dir/devcontainer.json"

    require_command python3
    mkdir -p "$output_dir"
    python3 - "$config" "$output" "$ROOT" <<'PY'
import json
import sys
from pathlib import Path

source, output, root = sys.argv[1:]
device = "--device=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0:/dev/pedestal"

with open(source, encoding="utf-8") as f:
    config = json.load(f)

run_args = config.setdefault("runArgs", [])
if device not in run_args:
    run_args.append(device)

build = config.setdefault("build", {})
build["dockerfile"] = str(Path(root) / ".devcontainer" / "Dockerfile")
build["context"] = root

with open(output, "w", encoding="utf-8") as f:
    json.dump(config, f, indent=4)
    f.write("\n")
PY
    printf '%s\n' "$output"
}

nvidia_cdi_available() {
    command -v nvidia-smi >/dev/null 2>&1 \
        && command -v nvidia-ctk >/dev/null 2>&1 \
        && nvidia-ctk cdi list 2>/dev/null | grep -q '^nvidia.com/gpu='
}

zdotdir_source() {
    local target

    if [[ ! -L "$HOST_ZDOTDIR/.zshrc" ]]; then
        printf '%s\n' "$HOST_ZDOTDIR"
        return
    fi

    target="$(readlink "$HOST_ZDOTDIR/.zshrc")"
    if [[ "$target" != /* ]]; then
        target="$HOST_ZDOTDIR/$target"
    fi

    (cd "$(dirname "$target")" && pwd -P)
}

up_container() {
    local config
    local host_plugins
    local resolved_plugins
    local zdotdir_mount
    local -a mounts=()

    config="$(config_file)"

    if [[ -d "$HOME/.config/nvim" ]]; then
        mounts+=(
            --mount
            "type=bind,source=$HOME/.config/nvim,target=/home/ubuntu/.config/nvim"
        )
    fi

    if [[ -d "$HOST_ZDOTDIR" ]]; then
        zdotdir_mount="$(zdotdir_source)"
        mounts+=(
            --mount
            "type=bind,source=$zdotdir_mount,target=$CONTAINER_ZDOTDIR"
        )

        if [[ -d "$HOST_ZDOTDIR/plugins" ]]; then
            host_plugins="$(cd "$HOST_ZDOTDIR/plugins" && pwd -P)"
            if [[ -d "$zdotdir_mount/plugins" ]]; then
                resolved_plugins="$(cd "$zdotdir_mount/plugins" && pwd -P)"
            else
                resolved_plugins=""
            fi
        fi

        if [[ -n "${host_plugins:-}" && "$host_plugins" != "$resolved_plugins" ]]; then
            mounts+=(
                --mount
                "type=bind,source=$HOST_ZDOTDIR/plugins,target=$CONTAINER_ZDOTDIR/plugins"
            )
        fi
    fi

    devcontainer up \
        --workspace-folder "$ROOT" \
        --config "$config" \
        "${mounts[@]}" \
        "$@"
}

exec_container() {
    local config

    up_container >/dev/null
    config="$(config_file)"

    devcontainer exec \
        --workspace-folder "$ROOT" \
        --config "$config" \
        "$@"
}

exec_shell() {
    local -a env_args=(env "TERM=$CONTAINER_TERM")

    if [[ -n "${COLORTERM:-}" ]]; then
        env_args+=("COLORTERM=$COLORTERM")
    fi

    if [[ -d "$HOST_ZDOTDIR" ]]; then
        env_args+=("ZDOTDIR=$CONTAINER_ZDOTDIR")
    fi

    exec_container "${env_args[@]}" zsh -l
}

exec_nvim() {
    local -a env_args=(env "TERM=$CONTAINER_TERM")

    if [[ -n "${COLORTERM:-}" ]]; then
        env_args+=("COLORTERM=$COLORTERM")
    fi

    if [[ -d "$HOST_ZDOTDIR" ]]; then
        env_args+=("ZDOTDIR=$CONTAINER_ZDOTDIR")
    fi

    exec_container "${env_args[@]}" zsh -ic 'cd /workspace && exec nvim .'
}

stop_containers() {
    local all_ids
    local running_ids

    all_ids="$(docker ps -aq --filter "label=devcontainer.local_folder=$ROOT")"
    if [[ -z "$all_ids" ]]; then
        echo "No devcontainers found for $ROOT"
        return
    fi

    running_ids="$(docker ps -q --filter "label=devcontainer.local_folder=$ROOT")"
    if [[ -n "$running_ids" ]]; then
        docker stop $running_ids
    fi

    docker rm $all_ids
}

require_command docker
require_command devcontainer

case "${1:-}" in
    up)
        up_container
        ;;
    shell)
        exec_shell
        ;;
    nvim)
        exec_nvim
        ;;
    rebuild)
        up_container --remove-existing-container
        ;;
    stop)
        stop_containers
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
